
@PACKAGE_INIT@

# ---------------------------------------------------------------
# FetchContent / add_subdirectory mode
# ---------------------------------------------------------------
if(TARGET ruy)
    if(NOT TARGET ruy::ruy)
        # Use IMPORTED INTERFACE, not ALIAS.
        # An ALIAS to a real target causes install(EXPORT) to require
        # 'ruy' to be in an export set, which it never will be.
        # An IMPORTED target is treated as external and exempt from that check.
        add_library(ruy::ruy INTERFACE IMPORTED GLOBAL)
        set_target_properties(ruy::ruy PROPERTIES
            INTERFACE_LINK_LIBRARIES "ruy"
        )
    endif()
    set(ruy_FOUND TRUE)
    set(ruy_LIBRARIES ruy::ruy

    get_target_property(_ruy_inc ruy INTERFACE_INCLUDE_DIRECTORIES)
    set(ruy_INCLUDE_DIRS "${_ruy_inc}")

    return()
endif()

# ---------------------------------------------------------------
# Installed-package mode
# ---------------------------------------------------------------
find_package(PkgConfig)
pkg_check_modules(libcpuinfo REQUIRED libcpuinfo)

set(_targets_file "${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
if(EXISTS "${_targets_file}")
    include("${_targets_file}")
endif()
